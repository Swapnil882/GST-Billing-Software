# ==============================================================================
# GST Billing Software - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Metadata
APP_NAME="GST Billing Software"
APP_ENV=production
APP_VERSION=2.0.0

# Server Binding
APP_HOST=127.0.0.1
APP_PORT=47371

# Browser Launch
AUTO_OPEN_BROWSER=true

# Logging Level: debug | info | warning | error | critical
LOG_LEVEL=info

# PostgreSQL Database Configuration
DB_ENABLED=true
DB_ENGINE=postgresql
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=5432
DB_NAME=GST-Billing
DATABASE_URL="postgresql://postgres:12345@localhost:5432/GST-Billing"

# File Storage Directories
DATA_DIR=./data
INVOICES_DIR=./Saved Invoices
FRONTEND_DIST=./frontend/dist

# Security & PIN Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_SECONDS=30

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# In-Memory Cache TTL (in seconds)
CACHE_TTL_SECONDS=5

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:47371,http://127.0.0.1:47371,http://localhost:5173,http://127.0.0.1:5173"
